{
  "name": "status",
  "description": "An open-source solution for companies needing to display service status's to their end-users.",
  "version": "0.0.1",
  "author": {
    "name": "Inticate Softworks",
    "email": "contact@inticate.com"
  },
  "license": "MIT",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "start": "concurrently --raw \"bun start:client\" \"bun start:server\"",
    "dev": "concurrently --raw \"bun dev:client\" \"bun dev:server\"",
    "lint": "concurrently --raw \"bun lint:client\" \"bun lint:server\"",
    "build": "concurrently --raw \"bun run build:client\" \"bun run build:server\"",
    "start:server": "cd server && bun start",
    "dev:server": "cd server && bun dev",
    "build:server": "cd server && bun run build",
    "clean:server": "cd server && bun clean",
    "lint:server": "cd server && bun lint",
    "start:client": "cd client && bun start",
    "dev:client": "cd client && bun dev",
    "build:client": "cd client && bun run build",
    "lint:client": "cd client && bun lint",
    "prepare": "husky"
  },
  "prettier": {
    "semi": true,
    "singleQuote": false,
    "trailingComma": "none",
    "arrowParens": "avoid",
    "endOfLine": "lf",
    "bracketSpacing": true,
    "bracketSameLine": false,
    "printWidth": 100
  },
  "lint-staged": {
    "apps/client/**/*.{ts,tsx,js,jsx,cjs,mjs}": "bun --cwd apps/client eslint --fix",
    "apps/server/**/*.{ts,tsx,js,jsx,cjs,mjs}": "bun eslint --fix",
    "**/*": "bunx prettier --write --ignore-unknown"
  },
  "dependencies": {
    "dotenv": "^17.3.1"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^20.5.0",
    "@eslint/js": "^10.0.1",
    "commitlint": "^20.5.0",
    "concurrently": "^9.2.1",
    "eslint": "^10.0.3",
    "husky": "^9.1.7",
    "prettier": "^3.8.1",
    "rimraf": "^6.1.3",
    "tsx": "^4.21.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.57.1"
  }
}
